# VELLOR MENSWEAR – produção bloqueada por padrão; não inclua credenciais no ZIP.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SITE_URL=https://vellormenswear.vercel.app
# Split 1:1 - configure no painel Mercado Pago (aplicação modelo Marketplace)
MP_MODE=sandbox
MP_SPLIT_ENABLED=false
STORE_OPEN_FOR_ORDERS=false
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://vellormenswear.vercel.app/api/marketplace/oauth-callback
MP_WEBHOOK_SECRET=
# Gere 32 bytes de forma segura; 64 caracteres hexadecimais. Jamais compartilhe a chave.
MP_TOKEN_ENCRYPTION_KEY=
# Legado: token Orders API desnecessário no fluxo Split, mantido apenas se já existir histórico
MP_TEST_ACCESS_TOKEN=
# Upload de fotos no portal
BLOB_READ_WRITE_TOKEN=
# Recuperação de senha (opcional)
RESEND_API_KEY=
EMAIL_FROM=Vellor Menswear <contato@seu-dominio.com>
# Primeiro super admin: configurar apenas em terminal confiável, não na Vercel
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
