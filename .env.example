# VELLOR MENSWEAR – produção bloqueada por padrão; não inclua credenciais no ZIP.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?sslmode=require
SITE_URL=https://vellormenswear.vercel.app
# Split 1:1 - configure no painel Mercado Pago (aplicação modelo Marketplace)
MP_MODE=sandbox
MP_SPLIT_ENABLED=false
# Só permite pagamentos reais após testes e autorização explícita:
MP_LIVE_ENABLED=false
STORE_OPEN_FOR_ORDERS=false
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://vellormenswear.vercel.app/api/marketplace/oauth-callback
MP_WEBHOOK_SECRET=
# Gere 32 bytes de forma segura; 64 caracteres hexadecimais. Jamais compartilhe a chave.
MP_TOKEN_ENCRYPTION_KEY=
# Credencial SOMENTE do ambiente de testes da aplicacao principal: usada pelo canario Split 1:N.
# NUNCA enviar token ao navegador. A cobranca comercial segue bloqueada.
MP_TEST_ACCESS_TOKEN=

# PREPARACAO do Split 1:N (Checkout Transparente, Orders API) com VELLOR como seller owner.
# Requer habilitacao comercial do Mercado Pago. Falso por padrao; nao ativa checkout da loja.
MP_PRIMARY_1N_ENABLED=false
MP_PRIMARY_1N_APPROVED=false
# User ID da conta VELLOR vendedora principal de TESTE (nao ID da aplicacao).
MP_PRIMARY_TEST_SELLER_USER_ID=
# Conta do fornecedor secundario em testes, para criar o consentimento ACTIVE.
MP_SECONDARY_TEST_SELLER_EMAIL=
# receiver_id UUID retornado pela API de consentimento (nao User ID do fornecedor).
MP_SECONDARY_TEST_RECEIVER_ID=
# Upload de fotos no portal
BLOB_READ_WRITE_TOKEN=
# Recuperação de senha (opcional)
RESEND_API_KEY=
EMAIL_FROM=Vellor Menswear <contato@seu-dominio.com>
# Primeiro super admin: configurar apenas em terminal confiável, não na Vercel
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Para liberar o checkout, configure MP_WEBHOOK_SECRET no painel Mercado Pago,
# deixe WEBSITE_URL / SITE_URL em HTTPS e ative as variáveis de ambiente na Vercel.
# Não coloque Access Tokens, CLIENT_SECRET nem chaves no código ou no ZIP.
